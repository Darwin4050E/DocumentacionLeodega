@startuml actividad_03
title Diagrama de Actividad 03 — Publicación y moderación de bodega (Heredado)
skinparam backgroundColor #FFFFFF
skinparam wrapWidth 220
skinparam activity {
  BackgroundColor<<Heredado>> #D6EAF8
  BorderColor<<Heredado>> #2E86C1
  BackgroundColor<<Nuevo>> #D5F5E3
  BorderColor<<Nuevo>> #27AE60
}
skinparam legend {
  BackgroundColor #FDFEFE
}

legend right
  |= Color |= Estado |
  |<#D6EAF8>| Heredado (equipo anterior, existe en código) |
  |<#D5F5E3>| Nuevo (planificado, ERS — sin código todavía) |
endlegend

|Arrendador|
start
:Completa formulario de bodega\n(título, dirección, ciudad, tamaño, tipo, precios);<<#D6EAF8>>
:Adjunta fotos (opcional,\nver Diagrama de Secuencia 8);<<#D6EAF8>>

|StoreRoomsController|
:store(): StoreStoreRoomRequest valida\nlos campos;<<#D6EAF8>>
:Crea StoreRooms con\npublication_status = "pending";<<#D6EAF8>>

|Arrendador|
:Espera revisión administrativa;<<#D6EAF8>>

|Administrador|
:Revisa bodegas con\npublication_status = "pending";<<#D6EAF8>>
:Decide aprobar o rechazar;<<#D6EAF8>>

|StoreRoomsController|
if (¿Usuario autenticado tiene role == "admin"?) then (no)
  :Responde 403\n"Solo un administrador puede\naprobar o rechazar una bodega";<<#D6EAF8>>
  stop
else (sí)
endif
if (¿Decisión?) then (rechazar)
  :Valida reason_rejected\n(obligatorio si se rechaza);<<#D6EAF8>>
else (aprobar)
endif

|StoreModerationService|
:moderate(room, decision, reason, adminId)\n(dentro de una transacción DB);<<#D6EAF8>>
if (decision?) then (approved)
  :Actualiza StoreRooms.publication_status\n= "approved";<<#D6EAF8>>
else (rejected)
  :Actualiza StoreRooms.publication_status\n= "rejected";<<#D6EAF8>>
endif
:Crea registro de auditoría\nen StoreModeration\n(reason_rejected, moderation_date);<<#D6EAF8>>
:Notifica al arrendador\n(STORE_APPROVED / STORE_REJECTED);<<#D6EAF8>>

|Arrendador|
if (decision?) then (approved)
  :Recibe notificación:\nbodega aprobada y visible\nen el catálogo público;<<#D6EAF8>>
  stop
else (rejected)
  :Recibe notificación:\nbodega rechazada con motivo;<<#D6EAF8>>
  stop
endif

@enduml
