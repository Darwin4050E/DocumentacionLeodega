@startuml diagrama_clases_03_reservas_pagos
title Diagrama de Clases 03 — Reservas y Pagos
skinparam backgroundColor #FFFFFF
skinparam wrapWidth 220
skinparam defaultTextAlignment left
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 45
skinparam class {
  BackgroundColor<<Heredado>> #D6EAF8
  BorderColor<<Heredado>> #2E86C1
  BackgroundColor<<Referencia>> #EAECEE
  BorderColor<<Referencia>> #839192
  BackgroundColor #EAECEE
}
skinparam package {
  BackgroundColor #FDFEFE
  BorderColor #839192
  FontStyle bold
}
skinparam legend {
  BackgroundColor #FDFEFE
}

legend right
  |= Color |= Estado / Rol |
  |<#D6EAF8>| Heredado (equipo anterior) |
  |<#EAECEE>| Referencia (definida en otro diagrama) |
endlegend

class User <<Referencia>> {
  .. definida en Diagrama de Clases 01 (Usuarios y Roles) ..
}
class Tenants <<Referencia>> {
  .. definida en Diagrama de Clases 01 (Usuarios y Roles) ..
}
class StoreRooms <<Referencia>> {
  .. definida en Diagrama de Clases 02 (Almacenes) ..
}

package "Reservas y Pagos" <<Heredado>> {
  class Reservations <<Heredado>> {
    - id: int
    - store_room_id: int
    - tenant_id: int
    - start_date: date
    - end_date: date
    - status: enum{pending,confirmed,canceled}
    - total_mount: decimal
    - cancelation_reason: string
    - creation_date: datetime
  }

  class Payments <<Heredado>> {
    - id: int
    - reservation_id: int
    - payment_method: enum{credit card,debit card}
    - payment_state: enum{paid,pending,failed}
    - payment_date: date
  }

  class Ratings <<Heredado>> {
    - id: int
    - store_id: int
    - user_id: int
    - stars: int
    - comment: string
  }

  class Favorites <<Heredado>> {
    - id: int
    - user_id: int
    - store_room_id: int
    - save_date: date
  }
}

Tenants "1" -- "0..*" Reservations : reserva
StoreRooms "1" -- "0..*" Reservations : es reservada en
Reservations "1" *-- "0..*" Payments : registra
StoreRooms "1" -- "0..*" Ratings : es calificada en
User "1" -- "0..*" Ratings : califica
User "1" -- "0..*" Favorites : guarda
StoreRooms "1" -- "0..*" Favorites : guardada en

@enduml
