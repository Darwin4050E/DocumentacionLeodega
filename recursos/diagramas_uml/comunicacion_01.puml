@startuml comunicacion_01
allowmixing
title Diagrama de Comunicación 01 -- Inicio de sesión (corresponde a Secuencia #2)
skinparam backgroundColor #FFFFFF
skinparam wrapWidth 190
skinparam defaultTextAlignment left
skinparam nodesep 150
skinparam ranksep 55
skinparam object {
  BackgroundColor<<Heredado>> #D6EAF8
  BorderColor<<Heredado>> #2E86C1
  BackgroundColor<<Actor>> #FCF3CF
  BorderColor<<Actor>> #B7950B
}
skinparam ArrowColor #2C3E50
skinparam ArrowFontSize 12
skinparam legend {
  BackgroundColor #FDFEFE
}

legend right
  |= Color |= Rol |
  |<#FCF3CF>| Actor humano |
  |<#D6EAF8>| Objeto Heredado (equipo anterior) |
endlegend

object "usuario : Usuario" as U <<Actor>>
note top of U
  N, N.M = orden y jerarquía del mensaje
  (N.M se dispara dentro del procesamiento de N)
end note

object "frontend : Frontend" as FE <<Heredado>>
together {
  object "authController : AuthController" as AC <<Heredado>>
  database "user : User" as DB <<Heredado>>
}
object "authService : AuthService" as AS <<Heredado>>
object "tokenStore : TokenStore\n(Sanctum)" as TS <<Heredado>>

U -down-> FE : 1: ingresarCredenciales()
FE -down-> AC : 2: login(): {token, user}
AC -right-> DB : 2.1: findByEmail(): user
AC -> AC : 2.2: validarCredenciales()
AC -down-> AS : 2.3: ensureUserIsNotBlocked();\n[activo] issueTokenFor(): token
AS -right-> TS : 2.3.1: create(ip, userAgent): token
FE -up-> U : 3: guardarEnLocalStorage() y mostrarPanel()

note bottom of AS
  2.3 lanza AccountBlockedException
  si user.state = 'blocked'
end note

@enduml
