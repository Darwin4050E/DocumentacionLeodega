@startuml diagrama_clases_05_moderacion_reportes
title Diagrama de Clases 05 — Moderación y Reportes
skinparam backgroundColor #FFFFFF
skinparam wrapWidth 220
skinparam defaultTextAlignment left
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 45
skinparam class {
  BackgroundColor<<Heredado>> #D6EAF8
  BorderColor<<Heredado>> #2E86C1
  BackgroundColor<<Referencia>> #EAECEE
  BorderColor<<Referencia>> #839192
  BackgroundColor #EAECEE
}
skinparam package {
  BackgroundColor #FDFEFE
  BorderColor #839192
  FontStyle bold
}
skinparam legend {
  BackgroundColor #FDFEFE
}

legend right
  |= Color |= Estado / Rol |
  |<#D6EAF8>| Heredado (equipo anterior) |
  |<#EAECEE>| Referencia (definida en otro diagrama) |
endlegend

class User <<Referencia>> {
  .. definida en Diagrama de Clases 01 (Usuarios y Roles) ..
}
class StoreRooms <<Referencia>> {
  .. definida en Diagrama de Clases 02 (Almacenes) ..
}

package "Moderación y Reportes" <<Heredado>> {
  class Reports <<Heredado>> {
    - id: int
    - user_id: int
    - store_id: int
    - reported_user_id: int
    - title: string
    - priority: enum{low,medium,high}
    - report_type: string
    - description: string
    - status: enum{pending,resolved,canceled}
  }

  class ReportEvidences <<Heredado>> {
    - id: int
    - report_id: int
    - file_path: string
    - file_type: string
  }
}

User "1" -- "0..*" Reports : reporta
User "0..1" -- "0..*" Reports : es reportado
StoreRooms "1" -- "0..*" Reports : objeto de
Reports "1" *-- "0..*" ReportEvidences : adjunta

@enduml
