@startuml comunicacion_06
allowmixing
title Diagrama de Comunicación 06 -- Bloquear cuenta de usuario (corresponde a Secuencia #21, Nuevo planificado)
skinparam backgroundColor #FFFFFF
skinparam wrapWidth 190
skinparam defaultTextAlignment left
skinparam nodesep 150
skinparam ranksep 55
skinparam object {
  BackgroundColor<<Nuevo>> #D5F5E3
  BorderColor<<Nuevo>> #27AE60
  BackgroundColor<<Actor>> #FCF3CF
  BorderColor<<Actor>> #B7950B
}
skinparam ArrowColor #2C3E50
skinparam ArrowFontSize 12
skinparam legend {
  BackgroundColor #FDFEFE
}

legend right
  |= Color |= Rol |
  |<#FCF3CF>| Actor humano |
  |<#D5F5E3>| Objeto Nuevo (planificado, ERS) |
endlegend

object "administrador : Administrador" as ADM <<Actor>>
note top of ADM
  N, N.M = orden y jerarquía del mensaje
end note

object "frontend : Frontend" as FE <<Nuevo>>
object "adminController : AdminController" as AC <<Nuevo>>
together {
  object "userBlockingService : UserBlockingService" as UBS <<Nuevo>>
  database "user : User" as UDB <<Nuevo>>
  database "registroAuditoria : RegistroAuditoria" as RA <<Nuevo>>
}
object "tokenStore : TokenStore\n(Sanctum)" as TS <<Nuevo>>
object "notificationService : NotificationService" as NS <<Nuevo>>

ADM -down-> FE : 1: seleccionarUsuarioABloquear()
FE -down-> AC : 2: block(reason)
AC -down-> UBS : 3: block(user, reason, adminId)
UBS -right-> UDB : 3.1: update(state='blocked')
UBS -left-> TS : 3.2: revocarTokens()
UBS -right-> RA : 3.3: insert(action='block')
UBS -left-> NS : 3.4: send(notificacionBloqueo)
FE -up-> ADM : 4: mostrarUsuarioBloqueado()

note bottom of UBS
  Planificado -- ERS HUA-03, sin código todavía.
  La reactivación (state='active') sigue el mismo
  flujo sin el paso 3.2 (no revoca tokens).
end note

@enduml
