@startuml comunicacion_03
allowmixing
title Diagrama de Comunicación 03 -- Confirmar reserva con cancelación en cascada (corresponde a Secuencia #12)
skinparam backgroundColor #FFFFFF
skinparam wrapWidth 190
skinparam defaultTextAlignment left
skinparam nodesep 150
skinparam ranksep 90
skinparam object {
  BackgroundColor<<Heredado>> #D6EAF8
  BorderColor<<Heredado>> #2E86C1
  BackgroundColor<<Actor>> #FCF3CF
  BorderColor<<Actor>> #B7950B
}
skinparam ArrowColor #2C3E50
skinparam ArrowFontSize 12
skinparam legend {
  BackgroundColor #FDFEFE
}

legend right
  |= Color |= Rol |
  |<#FCF3CF>| Actor humano |
  |<#D6EAF8>| Objeto Heredado (equipo anterior) |
endlegend

object "arrendador : Arrendador" as L <<Actor>>
note top of L
  N, N.M = orden y jerarquía del mensaje
  (*) = mensaje iterativo (loop)
end note

object "frontend : Frontend" as FE <<Heredado>>
object "reservationsController : ReservationsController" as RC <<Heredado>>
together {
  object "reservationService : ReservationService" as RS <<Heredado>>
  database "reservations : Reservations" as RDB <<Heredado>>
}
object "notificationService : NotificationService" as NS <<Heredado>>
object "arrendatario : Arrendatario" as T <<Actor>>

NS -right- T

L -down-> FE : 1: confirmarReserva()
FE -down-> RC : 2: updateStatus(status='confirmed')
RC -down-> RS : 3: confirm()\n(valida UpdateReservationStatusRequest)
RS -right-> RDB : 3.1: findOverlappingConfirmed();\n[ok] update(status='confirmed');\n*cancel(status='canceled')
RS -down-> NS : 3.2: send(RESERVATION_CONFIRMED);\n*send(RESERVATION_CANCELED) a T
FE -up-> L : 4: mostrarConfirmacion()

note bottom of RS
  3.1 lanza ReservationConflictException si otra reserva
  confirmada se solapa en fechas (409). Las acciones marcadas (*)
  se repiten por cada reserva pendiente solapada en la bodega.
end note

@enduml
