@startuml comunicacion_04
allowmixing
title Diagrama de Comunicación 04 -- Procesar pago y confirmar reserva (corresponde a Secuencia #14)
skinparam backgroundColor #FFFFFF
skinparam wrapWidth 190
skinparam defaultTextAlignment left
skinparam nodesep 150
skinparam ranksep 55
skinparam object {
  BackgroundColor<<Heredado>> #D6EAF8
  BorderColor<<Heredado>> #2E86C1
  BackgroundColor<<Actor>> #FCF3CF
  BorderColor<<Actor>> #B7950B
}
skinparam ArrowColor #2C3E50
skinparam ArrowFontSize 12
skinparam legend {
  BackgroundColor #FDFEFE
}

legend right
  |= Color |= Rol |
  |<#FCF3CF>| Actor humano |
  |<#D6EAF8>| Objeto Heredado (equipo anterior) |
endlegend

object "arrendatario : Arrendatario" as T <<Actor>>
note top of T
  N, N.M = orden y jerarquía del mensaje
  (*) = mensaje iterativo (loop)
end note

object "frontend : Frontend" as FE <<Heredado>>
object "paymentsController : PaymentsController" as PC <<Heredado>>
object "paymentsPolicy : PaymentsPolicy" as PP <<Heredado>>
together {
  object "paymentService : PaymentService" as PS <<Heredado>>
  database "payments : Payments" as PDB <<Heredado>>
}
together {
  object "reservationService : ReservationService" as RS <<Heredado>>
  database "reservations : Reservations" as RDB <<Heredado>>
}
object "notificationService : NotificationService" as NS <<Heredado>>

T -down-> FE : 1: registrarPago()
FE -down-> PC : 2: store(): pago
PC -right-> PP : 3: create(): autorizado?
PC -down-> PS : 4: [autorizado] process()
PS -right-> PDB : 4.1: insert(pago)
PS -down-> RS : 4.2: [paid y no confirmada] confirm()
RS -right-> RDB : 4.2.1: update(status='confirmed');\n*cancel(reservasSolapadas)
RS -down-> NS : 4.2.2: send(RESERVATION_CONFIRMED);\n*send(RESERVATION_CANCELED)
FE -up-> T : 5: mostrarConfirmacionPago()

note bottom of PP
  3 deniega con 403 si el usuario no es
  el arrendatario dueño de la reserva
end note

@enduml
