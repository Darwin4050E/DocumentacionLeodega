@startuml diagrama_clases_07_policies
title Diagrama de Clases 07 — Autorización (Policies)
skinparam backgroundColor #FFFFFF
skinparam wrapWidth 220
skinparam defaultTextAlignment left
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 45
skinparam class {
  BackgroundColor<<Policy>> #F5EEF8
  BorderColor<<Policy>> #8E44AD
  BackgroundColor<<Referencia>> #EAECEE
  BorderColor<<Referencia>> #839192
  BackgroundColor #EAECEE
}
skinparam package {
  BackgroundColor #FDFEFE
  BorderColor #839192
  FontStyle bold
}
skinparam legend {
  BackgroundColor #FDFEFE
}

legend right
  |= Color |= Estado / Rol |
  |<#F5EEF8>| Policy (autorización) |
  |<#EAECEE>| Referencia (definida en otro diagrama) |
endlegend

class User <<Referencia>> {
  .. definida en Diagrama de Clases 01 (Usuarios y Roles) ..
}
class Landlords <<Referencia>> {
  .. definida en Diagrama de Clases 01 (Usuarios y Roles) ..
}
class Conversation <<Referencia>> {
  .. definida en Diagrama de Clases 04 (Comunicación) ..
}
class Reservations <<Referencia>> {
  .. definida en Diagrama de Clases 03 (Reservas y Pagos) ..
}

package "Autorización (Policies)" <<Policy>> {
  class ConversationPolicy <<Policy>> {
    + view(user: User, conversation: Conversation): bool
  }

  class ReservationsPolicy <<Policy>> {
    + updateStatus(user: User, reservation: Reservations,\nlandlord: Landlords): bool
  }

  class PaymentsPolicy <<Policy>> {
    + create(user: User, reservation: Reservations): bool
  }
}

ConversationPolicy ..> Conversation : evalúa
ConversationPolicy ..> User : evalúa
ReservationsPolicy ..> Reservations : evalúa
ReservationsPolicy ..> Landlords : evalúa
PaymentsPolicy ..> Reservations : evalúa
PaymentsPolicy ..> User : evalúa

@enduml
